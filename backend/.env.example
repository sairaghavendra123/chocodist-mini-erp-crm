# Backend Environment Configuration Reference
# Duplicate this file as .env in /backend for local execution

PORT=5001
NODE_ENV=development

# Database Connection
# SQLite (Local Dev):
DATABASE_URL="file:./dev.db"

# Neon PostgreSQL (Production Deployment):
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require"

# JWT Secret Key (Use a strong random secret in production)
JWT_SECRET="your_secure_jwt_secret_here"

# Frontend Application URL (For CORS Security)
FRONTEND_URL="http://localhost:5173"
