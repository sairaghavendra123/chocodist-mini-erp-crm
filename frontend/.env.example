# Frontend Environment Configuration Reference
# Duplicate this file as .env in /frontend for local execution or set in Vercel Environment Variables

# Backend API Endpoint URL
# Local Development (using Vite proxy to http://localhost:5001):
VITE_API_URL="http://localhost:5001/api"
VITE_API_BASE_URL="/api"

# Production Deployment (Render Deployed Backend):
# VITE_API_URL="https://chocodist-backend.onrender.com/api"
